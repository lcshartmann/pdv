# Printer configuration
# Options: usb | network | file
MARKET_POS_PRINTER_TYPE=file
# For file: directory path where timestamped receipts will be saved
# For usb: optional vid:pid (e.g. "0x1234:0x5678")
# For network: host:port (e.g. "192.168.1.100:9100")
MARKET_POS_PRINTER_ADDRESS=/home/lucashartmann/Documents/pdv/receipts

# Store name printed on receipts
MARKET_POS_STORE_NAME=Mercado Familiar
